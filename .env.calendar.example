# 구글 캘린더 읽기 프록시 설정 템플릿.
# 이 파일을 .env.calendar.local 로 복사해 값을 채우세요 (.local 은 git 제외됨):
#   cp .env.calendar.example .env.calendar.local
#   node scripts/calendar-proxy.mjs      (또는 npm run proxy — 통합 실행)
#
# 값을 채우기 전에는 휴면합니다. 화면은 지금처럼 샘플 회의로 계산 흐름만 보여줍니다.
#
# ── 구글 클라우드 콘솔에서 먼저 만들어야 하는 것 ──────────────────────
# 1) 프로젝트 생성 → 'API 및 서비스' → 라이브러리 → Google Calendar API 사용 설정
# 2) OAuth 동의 화면 구성(내부(Internal)로 두면 사내 계정만 씁니다)
#    - 범위(스코프)에 .../auth/calendar.readonly 추가
# 3) 사용자 인증 정보 → OAuth 클라이언트 ID → 웹 애플리케이션
#    - 승인된 리디렉션 URI 에 아래 GOOGLE_REDIRECT_URI 값을 그대로 등록
# ─────────────────────────────────────────────────────────────────

# OAuth 클라이언트 ID / 시크릿.
# 이 파일은 git 이 추적합니다. 실제 값은 .env.calendar.local 에만 넣으세요.
GOOGLE_CLIENT_ID=여기에_클라이언트_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-여기에_클라이언트_시크릿

# 구글 콘솔의 '승인된 리디렉션 URI' 와 문자 하나까지 같아야 합니다.
# 쿼리(?...)를 붙이지 마세요 — 쿼리가 든 리디렉션 URI 는 구글 콘솔이 거부하는 경우가 있습니다.
# 로컬 통합 프록시(npm run proxy, 8787):
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/calendar/callback
# 단독 실행(node scripts/calendar-proxy.mjs, 8790)이라면:
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8790/api/calendar/callback
# 배포(Vercel)라면:
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/calendar/callback

# 액세스 토큰을 넘겨받을 앱 오리진. postMessage 대상과 CORS 허용 오리진으로 쓰입니다.
# '*' 로 열면 아무 창이나 토큰을 받아갈 수 있으므로 반드시 정확히 적으세요.
# vite 는 npm run dev 기준 127.0.0.1 로 뜹니다.
CALENDAR_ALLOWED_ORIGIN=http://127.0.0.1:5173

# 단독 실행 시 포트 (통합 실행이면 무시됩니다)
# CALENDAR_PORT=8790

# 읽을 캘린더 ID. 비워두면 접속 계정의 기본 캘린더(primary)를 읽습니다.
# 전용 계정이 팀 캘린더에 '초대만' 받은 경우 primary 는 비어 있으므로 반드시 지정하세요.
# 값은 구글 캘린더 → 캘린더 설정 → '캘린더 통합' 의 캘린더 ID 입니다.
# GOOGLE_CALENDAR_ID=xxxxx@group.calendar.google.com
