VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 접수 AI 사전 검토 프록시 주소. 비워두면(주석 상태) 검토 없이 접수된다(기능 없음 상태).
# 로컬에서 켜려면: npm run proxy 실행 후 아래 줄의 주석을 해제한다.
# 주석 해제한 채로 proxy 를 띄우지 않으면 매 제출마다 연결 실패 경고 배너가 뜬다.
# VITE_REVIEW_ENDPOINT=http://127.0.0.1:8787/api/review

# 구글 캘린더 읽기 프록시 주소. 비워두면(주석 상태) 파트지수·팀추억이 샘플 데이터로 동작한다.
# 로컬에서 켜려면: .env.calendar.example → .env.calendar.local 로 복사해 값을 채우고
# npm run proxy 를 띄운 뒤 아래 줄의 주석을 해제한다.
# VITE_CALENDAR_ENDPOINT=http://127.0.0.1:8787/api/calendar

# 모임 썸네일 생성(사진 미첨부 시). 없으면 기존 로컬 포스터를 그대로 쓴다.
# VITE_GATHERING_IMAGE_ENDPOINT=http://127.0.0.1:8787/api/gathering-image

# 유머 썸네일 생성(이미지 없는 글). 없으면 썸네일 없이 글을 그대로 둔다.
# VITE_HUMOR_IMAGE_ENDPOINT=http://127.0.0.1:8787/api/gathering-image
# VITE_CHAT_ENDPOINT=http://localhost:8790/
