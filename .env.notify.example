# 로컬 슬랙 프록시 설정 템플릿.
# 이 파일을 .env.notify.local 로 복사해 값을 채우세요 (.local 은 git 제외됨):
#   cp .env.notify.example .env.notify.local

# 봇 토큰 (Slack 앱 → OAuth & Permissions → Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-여기에_봇토큰

# 채널 ID. 테스트 중엔 팀/커넥셔너 둘 다 같은 테스트 채널로 두면 모든 알림이 그리로 옵니다.
SLACK_CHANNEL_TEAM=C0BL78G6YJH
SLACK_CHANNEL_CONNECTOR=C0BL78G6YJH

# 개인 DM 실제 발송 스위치. 계정 이메일=슬랙 이메일 확인 전까지 false 유지.
SLACK_DM_ENABLED=false

# 알림에 붙는 "화면 보러 가기" 링크의 앱 주소. 로컬은 http://127.0.0.1:5173, 배포 시 배포 URL.
APP_BASE_URL=http://127.0.0.1:5173

# PORT=8787
