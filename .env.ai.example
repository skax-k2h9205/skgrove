# 로컬 AI 취합 프록시(OpenRouter) 설정 템플릿.
# 이 파일을 .env.ai.local 로 복사해 값을 채우세요 (.local 은 git 제외됨):
#   cp .env.ai.example .env.ai.local
#   node scripts/ai-proxy.mjs

# OpenRouter API 키 (https://openrouter.ai/keys). 절대 커밋하지 마세요.
OPENROUTER_API_KEY=sk-or-여기에_키

# 사용할 모델 슬러그 (https://openrouter.ai/models 에서 확인).
# 저렴·충분: anthropic/claude-haiku-4.5  |  품질↑: anthropic/claude-sonnet-4.5
# 상담 답변 고도화(Phase 1a): GLM-5.2 — openrouter.ai/models 에서 정확한 슬러그 확인 후 프로덕션은 Vercel 환경변수 OPENROUTER_MODEL 로 지정.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# 모임 썸네일을 그리는 이미지 모델 (사진 미첨부 시). 물건·유머 썸네일도 같은 모델을 쓴다.
# (프론트의 VITE_GATHERING_IMAGE_ENDPOINT / VITE_HUMOR_IMAGE_ENDPOINT 가 이 프록시를 가리킨다)
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# 생성된 썸네일에 글자가 남았는지 검사하는 비전 모델.
# 이미지를 읽어야 하므로 비전 지원 모델이어야 한다. claude 계열은 이 경로에서 jpeg 를 거절한다.
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite

# 프록시 포트 (프론트의 VITE_AI_ENDPOINT 와 일치해야 함)
# PORT=8788

# 접수 검토 프록시를 단독 실행할 때의 포트 (node scripts/review-proxy.mjs)
# REVIEW_PORT=8789

# --- AI 상담 챗봇 프록시 (node scripts/chat-proxy.mjs) ---
# 프론트의 VITE_CHAT_ENDPOINT 가 이 프록시를 가리킨다. 예: http://localhost:8790/
# OPENROUTER_API_KEY / OPENROUTER_MODEL 은 위 값을 공유한다.
# CHAT_PORT=8790
